# Backend environment configuration
# Copy this file to backend/.env and replace placeholders with local or deployment values.

# Database connection string used by the backend persistence layer.
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>

# Secret used to sign and verify application authentication tokens.
SECRET_KEY=<backend-secret-key>

# Runtime environment, such as development, staging, or production.
ENVIRONMENT=development

# Allowed frontend origins for CORS, separated by commas when multiple origins are used.
CORS_ORIGINS=http://localhost:<frontend-port>

# Cloud provider credentials, if backend-managed uploads or services are enabled.
CLOUD_PROVIDER=<cloud-provider-name>
CLOUD_ACCESS_KEY_ID=<cloud-access-key-id>
CLOUD_SECRET_ACCESS_KEY=<cloud-secret-access-key>
CLOUD_REGION=<cloud-region>

# Optional object storage bucket for uploaded audio or research files.
CLOUD_STORAGE_BUCKET=<storage-bucket-name>
