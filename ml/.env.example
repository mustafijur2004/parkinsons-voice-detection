# Machine-learning pipeline environment configuration
# Copy this file to ml/.env and replace placeholders with local or deployment values.

# Database connection string for metadata, labels, or experiment records.
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>

# Secret used when the ML service accesses protected application resources.
SECRET_KEY=<ml-service-secret-key>

# Cloud provider credentials for datasets, model artifacts, or experiment storage.
CLOUD_PROVIDER=<cloud-provider-name>
CLOUD_ACCESS_KEY_ID=<cloud-access-key-id>
CLOUD_SECRET_ACCESS_KEY=<cloud-secret-access-key>
CLOUD_REGION=<cloud-region>

# Cloud storage locations for training data and serialized model artifacts.
DATA_BUCKET=<training-data-bucket-name>
MODEL_BUCKET=<model-artifacts-bucket-name>

# Optional experiment tracking configuration.
EXPERIMENT_TRACKING_URI=<experiment-tracking-server-url>
EXPERIMENT_TRACKING_TOKEN=<experiment-tracking-token>

# Optional external service endpoint used for prediction integration tests.
PREDICTION_API_URL=http://localhost:<backend-port>
